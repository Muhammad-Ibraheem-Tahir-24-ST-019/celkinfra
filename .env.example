# Copy to `.env` for local development. `.env*` is gitignored.
# In production these are Worker bindings/secrets, not a file:
#   wrangler secret put ADMIN_EMAILS
# or set them in the Cloudflare dashboard.

# ---------------------------------------------------------------------------
# BUILD TIME — read by `npm run build`, baked into the output.
# ---------------------------------------------------------------------------

# Canonical origin, no trailing slash. Drives <link rel="canonical">,
# sitemap.xml, robots.txt, Open Graph URLs and every JSON-LD @id.
# If unset, the build falls back to SITE_URL_FALLBACK in lib/seo.ts.
# Changing this requires a rebuild.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# RUNTIME — read from the Worker environment (see lib/server.ts).
# ---------------------------------------------------------------------------

# Comma-separated allowlist of admin email addresses. A visitor reaches /admin
# only with an authenticated session AND an email listed here. Leave empty to
# lock the admin panel entirely.
ADMIN_EMAILS=

# Optional. Raises Globalping quotas for the probe-based tools
# (ping, traceroute, port checker, SMTP test). https://globalping.io
GLOBALPING_TOKEN=

# Optional. Higher-accuracy IP geolocation. https://ipinfo.io
IPINFO_TOKEN=

# Optional. Point the probe-based tools at your own probe service instead of
# the default provider.
PROBE_SERVICE_URL=
PROBE_SERVICE_TOKEN=

# Note: the D1 database is provided as the `DB` *binding*, not as an env var.
# Configure it in your Cloudflare project (see .openai/hosting.json).
